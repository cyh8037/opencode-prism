{
  "name": "opencode-prism",
  "version": "0.5.0",
  "description": "Prism: OpenCode plugin for vision interpretation, parallel background agents, and task splitting",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyh8037/opencode-prism.git"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --outdir dist --target bun --external @opencode-ai/plugin --external zod",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "opencode": ">=1.15.0"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
